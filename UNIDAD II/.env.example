# Copiar como .env en CADA computadora. No compartir .env ni .venv.
# Origen exigido: MySQL 8, base sistema_residencia. No requiere XAMPP.
# Una instalación nativa suele usar 3306; esta computadora usa 3307.
# No se importa ni se borra una base existente al iniciar.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_residencia
MYSQL_USER=residencia_app
MYSQL_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_ESTE_EQUIPO

# Destino independiente: SQL Server instalado en Windows, remoto o ya existente.
# auto busca ODBC Driver 18 o 17. No escribir rutas de otra computadora.
SQLSERVER_DRIVER=auto
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
# Opcional: servidor/instancia completo, p. ej. localhost\SQLEXPRESS.
SQLSERVER_SERVER=
SQLSERVER_DATABASE=residencia_sqlserver
SQLSERVER_USER=residencia_grupo3
SQLSERVER_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_ESTE_EQUIPO
SQLSERVER_TRUST_CERTIFICATE=yes
FLASK_PORT=5000
FLASK_DEBUG=0
