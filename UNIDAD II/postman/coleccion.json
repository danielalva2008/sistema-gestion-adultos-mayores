            "url": "{{base_url}}/api/personal/kpis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON con ok\", () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "pm.test(\"15 activos\",()=>pm.expect(pm.response.json().data.personal_activo).to.eql(15));"
                ]
