    {
      "name": "CRUD (ejecutar en orden)",
      "item": [
        {
          "name": "Crear temporal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/personal",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_personal\": \"{{codigo_prueba}}\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Postman\",\n  \"cargo\": \"Prueba\",\n  \"especialidad\": \"\",\n  \"telefono\": \"999111222\",\n  \"email\": \"prueba@example.com\",\n  \"fecha_ingreso\": \"2025-01-01\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigo_prueba\", \"T\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON con ok\", () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "pm.collectionVariables.set(\"personal_id\",pm.response.json().data.id_personal);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener temporal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/personal/{{personal_id}}"
