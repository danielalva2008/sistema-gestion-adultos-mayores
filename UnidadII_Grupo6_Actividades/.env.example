# ============================================================
#  Variables de entorno - Grupo 6 - Modulo Actividades
#  Copie este archivo como .env y complete sus credenciales.
#  El archivo .env NO se sube al repositorio.
# ============================================================

# ---- Origen: MySQL (base sistema_residencia) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sistema_residencia
# Usuario de aplicacion (solo SELECT/INSERT/UPDATE/DELETE), NO root
MYSQL_USER=residencia_app
MYSQL_PASSWORD=TU_PASSWORD_MYSQL

# ---- Destino: SQL Server (base residencia_sqlserver) ----
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=residencia_sqlserver
SQLSERVER_USER=residencia_sql
SQLSERVER_PASSWORD=TU_PASSWORD_SQLSERVER
# SQLSERVER_TRUSTED=1 usa autenticacion de Windows (sin usuario/clave y sin
# puerto; conecta por memoria compartida). Util si TCP 1433 no esta habilitado.
# Dejar en 0 para usar el usuario/clave de arriba por TCP (como pide el plan).
SQLSERVER_TRUSTED=0

# ---- Flask ----
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
